{
  "expo": {
    "name": "heybud",
    "slug": "heybud",
    "scheme": "heybud",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.heybudhq.heybud"
    },
    "android": {
      "package": "com.heybudhq.heybud"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "REPLACE_WITH_MAPBOX_DOWNLOAD_TOKEN"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
