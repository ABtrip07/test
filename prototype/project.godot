; Engine configuration file.

[application]

config/name="The Last Collective - Prototype"
config/features=PackedStringArray("4.4")
run/main_scene="res://game/main.tscn"

[autoload]

Resources="*res://autoloads/resource_subsystem.gd"
Villagers="*res://autoloads/villager_subsystem.gd"
Decrees="*res://autoloads/decree_system.gd"
Lots="*res://autoloads/lot_system.gd"
Army="*res://autoloads/army_manager.gd"
Clans="*res://autoloads/clan_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.12, 1)
